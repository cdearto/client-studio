# Copy to .env.local, or run `npm run setup` to generate it.
BUSINESS_NAME="Acme Studio"
# Signs texts and emails: "Hi Jane, it's Sam from Acme Studio…"
OWNER_NAME="Sam"
# Used in links sent to clients.
SITE_URL="https://studio.example.com"
TZ="America/Los_Angeles"
# Booking alerts go here; client replies too.
NOTIFY_EMAIL="owner@example.com"
FROM_EMAIL=""
# Any SMTP provider, e.g. smtps://user:pass@smtp.example.com:465. Blank = emails are written to data/outbox.log.
SMTP_URL=""
# Venmo username for the pay button. Blank hides it.
VENMO=""
# Newsletter social links: instagram, facebook, tiktok, youtube, linkedin, x, spotify.
SOCIAL_LINKS="instagram=https://www.instagram.com/your-handle"

# Studio login. The hash comes from `npm run setup` (scrypt).
ADMIN_USER="admin"
ADMIN_PASSWORD_HASH=""
# Signs the session cookie and unsubscribe links. 32+ random bytes, e.g. `openssl rand -hex 32`.
APP_SECRET=""

# Reverse proxies in front of the app (1 for Vercel, Render, Fly, nginx…). Used to find the real client IP.
TRUSTED_PROXIES="1"
# SQLite location (default: ./data)
DATA_DIR=""
